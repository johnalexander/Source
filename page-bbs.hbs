{{!< default}}
{{!-- Template for the /bbs page. Ghost Admin: create a page with slug "bbs".
     This template fetches art + stories directly from the BBS API and renders
     them natively in Ghost's canvas — no iframe, no duplicate wordmark. --}}

{{#post}}
<main class="gh-main">
    <article class="gh-article {{post_class}}">

        <section class="gh-content gh-canvas bbs-page-section">

            {{!-- ── Art + stories block (populated by JS) ─────────────────── --}}
            <div class="bbs-block" id="bbs-block">

                {{!-- Skeleton shown while loading --}}
                <div class="bbs-loading" id="bbs-loading">
                    <div class="bbs-loading-bar"></div>
                </div>

                {{!-- Art rendered here --}}
                <pre class="bbs-art" id="bbs-art" aria-label="ASCII art"></pre>
                <p class="bbs-caption" id="bbs-caption"></p>

                <hr class="bbs-rule">

                <p class="bbs-stories-label">RECENT STORIES</p>
                <ul class="bbs-stories" id="bbs-stories"></ul>

                <hr class="bbs-rule">

            </div>

            {{!-- ── CTA ─────────────────────────────────────────────────────── --}}
            {{#unless @member}}
            <div class="bbs-cta-wrap">
                <a href="#/portal/signup" class="gh-button bbs-cta-btn" data-portal="signup">
                    Subscribe to SouthPole →
                </a>
            </div>
            {{else}}
            <div class="bbs-cta-wrap" id="bbs-member-cta">
                {{!-- Default: enter the BBS (hidden until member-status check completes) --}}
                <a
                    href="https://bbs.southpole.blog"
                    id="bbs-enter-btn"
                    class="gh-button bbs-cta-btn"
                    style="display:none"
                >Enter the BBS →</a>
                {{!-- Shown if member has no handle yet --}}
                <button
                    id="bbs-invite-btn"
                    class="gh-button bbs-cta-btn bbs-cta-outline"
                    type="button"
                    style="display:none"
                >Send my BBS invite →</button>
                <p id="bbs-invite-confirm" class="bbs-invite-confirm" style="display:none"></p>
            </div>
            {{/unless}}

        </section>

    </article>
</main>

<style>
    /* ── Page section ────────────────────────────────────────────── */
    .bbs-page-section {
        padding-top: 0;
    }

    /* ── Art block ───────────────────────────────────────────────── */
    .bbs-block {
        background: #0a0a0a;
        border-radius: 6px;
        padding: 20px 20px 12px;
        margin-bottom: 20px;
        font-family: 'Courier New', Courier, monospace;
    }

    /* Loading skeleton */
    .bbs-loading {
        padding: 40px 0;
        display: flex;
        justify-content: center;
    }

    .bbs-loading-bar {
        width: 120px;
        height: 3px;
        background: #1a3322;
        border-radius: 2px;
        animation: bbs-pulse 1.4s ease-in-out infinite;
    }

    @keyframes bbs-pulse {
        0%, 100% { opacity: 0.3; }
        50%       { opacity: 1; }
    }

    /* Art */
    .bbs-art {
        font-family: 'Courier New', Courier, 'Lucida Console', monospace;
        font-size: clamp(6px, 1.1vw, 10px);
        line-height: 1.1;
        white-space: pre;
        overflow: hidden;
        color: #00ff88;
        margin: 0 0 6px;
        display: none; /* shown by JS after load */
    }

    .bbs-caption {
        font-family: 'Courier New', Courier, monospace;
        font-size: 11px;
        color: #446644;
        margin: 0 0 0;
        display: none;
    }

    /* Divider */
    .bbs-rule {
        border: none;
        border-top: 1px solid #1a3322;
        margin: 12px 0;
    }

    /* Stories */
    .bbs-stories-label {
        font-family: 'Courier New', Courier, monospace;
        font-size: 10px;
        color: #44aa66;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        margin: 0 0 6px;
        display: none;
    }

    .bbs-stories {
        list-style: none;
        padding: 0;
        margin: 0;
        font-family: 'Courier New', Courier, monospace;
        font-size: 12px;
        color: #88cc99;
        line-height: 1.65;
        display: none;
    }

    .bbs-stories li.muted {
        color: #336644;
    }

    /* ── CTA ─────────────────────────────────────────────────────── */
    .bbs-cta-wrap {
        text-align: center;
        padding: 4px 0 8px;
    }

    .bbs-cta-btn {
        display: inline-block;
        padding: 10px 26px;
        font-size: 0.95rem;
        font-weight: 600;
        text-decoration: none;
        border-radius: 4px;
        cursor: pointer;
        background: var(--ghost-accent-color, #15171a);
        color: #fff;
        border: none;
    }

    .bbs-cta-outline {
        background: transparent;
        color: var(--ghost-accent-color, #15171a);
        border: 2px solid currentColor;
    }

    .bbs-invite-confirm {
        margin-top: 10px;
        font-size: 0.875rem;
        color: var(--color-secondary-text, #6b7280);
    }
</style>

{{!-- ── JS: fetch BBS preview data + wire up member CTA ─────────────── --}}
<script>
(function () {
    var ANSI_TABLE = [[0,0,0],[128,0,0],[0,128,0],[128,128,0],[0,0,128],[128,0,128],[0,128,128],[192,192,192],[128,128,128],[255,0,0],[0,255,0],[255,255,0],[0,0,255],[255,0,255],[0,255,255],[255,255,255]];
    function ansi256(c){if(c<16)return ANSI_TABLE[c];if(c>=232){var g=8+(c-232)*10;return[g,g,g];}var i=c-16,r=Math.floor(i/36),g=Math.floor((i%36)/6),b=i%6,s=function(v){return Math.round((v/5)*255);};return[s(r),s(g),s(b)];}
    function esc(s){return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
    function ansiToHtml(input){var re=/\x1b\[[0-9;]*m/g,fg=null,bg=null,html='',last=0,m;
        function span(t){if(!t)return;var st=[];if(fg!==null){var c=ansi256(fg);st.push('color:rgb('+c[0]+','+c[1]+','+c[2]+')');}if(bg!==null){var c2=ansi256(bg);st.push('background:rgb('+c2[0]+','+c2[1]+','+c2[2]+')');}html+='<span'+(st.length?' style="'+st.join(';')+'"':'')+'>'+esc(t)+'</span>';}
        while((m=re.exec(input))!==null){span(input.slice(last,m.index));var codes=m[0].slice(2,-1).split(';').filter(Boolean).map(Number);if(!codes.length){fg=null;bg=null;}else{for(var i=0;i<codes.length;i++){var c=codes[i];if(c===0){fg=null;bg=null;}else if(c===38&&codes[i+1]===5){fg=codes[i+2];i+=2;}else if(c===48&&codes[i+1]===5){bg=codes[i+2];i+=2;}}}last=re.lastIndex;}span(input.slice(last));return html;}

    var loadingEl  = document.getElementById('bbs-loading');
    var artEl      = document.getElementById('bbs-art');
    var captionEl  = document.getElementById('bbs-caption');
    var storiesEl  = document.getElementById('bbs-stories');
    var labelEl    = document.querySelector('.bbs-stories-label');

    fetch('https://bbs.southpole.blog/api/bbs-preview')
        .then(function(r){ return r.json(); })
        .then(function(data){
            if (loadingEl) loadingEl.style.display = 'none';

            if (data.art && artEl) {
                artEl.innerHTML = ansiToHtml(data.art);
                artEl.style.display = 'block';
            }

            if (captionEl) {
                var parts = [data.title, data.artist].filter(Boolean);
                if (parts.length) {
                    captionEl.textContent = parts.join(' \u2014 ');
                    captionEl.style.display = 'block';
                }
            }

            if (storiesEl && data.stories && data.stories.length) {
                storiesEl.innerHTML = data.stories.map(function(t){
                    return '<li>&gt; ' + esc(t) + '</li>';
                }).join('');
                storiesEl.style.display = 'block';
                if (labelEl) labelEl.style.display = 'block';
            } else if (storiesEl) {
                storiesEl.innerHTML = '<li class="muted">No stories yet.</li>';
                storiesEl.style.display = 'block';
                if (labelEl) labelEl.style.display = 'block';
            }
        })
        .catch(function(){
            if (loadingEl) loadingEl.style.display = 'none';
        });
}());
</script>

{{!-- Member CTA wiring lives in a separate block so Handlebars can emit uuid --}}
{{#unless @member}}{{else}}
<script>
(function () {
    var enterBtn  = document.getElementById('bbs-enter-btn');
    var inviteBtn = document.getElementById('bbs-invite-btn');
    var confirm   = document.getElementById('bbs-invite-confirm');
    var uuid      = '{{@member.uuid}}';

    if (!uuid) { if(enterBtn) enterBtn.style.display=''; return; }

    fetch('https://bbs.southpole.blog/api/member-status?uuid=' + encodeURIComponent(uuid), { credentials: 'omit' })
        .then(function(r){ return r.json(); })
        .then(function(data){
            if (data && data.hasHandle === false) {
                if (inviteBtn) inviteBtn.style.display = '';
            } else {
                if (enterBtn) enterBtn.style.display = '';
            }
        })
        .catch(function(){
            if (enterBtn) enterBtn.style.display = '';
        });

    if (inviteBtn) {
        inviteBtn.addEventListener('click', function(){
            inviteBtn.disabled = true;
            fetch('https://bbs.southpole.blog/api/resend-welcome', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ uuid: uuid }),
                credentials: 'omit'
            })
            .then(function(){
                if (confirm) { confirm.textContent = 'Done — check your inbox for the invite link.'; confirm.style.display = ''; }
                inviteBtn.style.display = 'none';
            })
            .catch(function(){
                inviteBtn.disabled = false;
                if (confirm) { confirm.textContent = 'Something went wrong. Please try again.'; confirm.style.display = ''; }
            });
        });
    }
}());
</script>
{{/unless}}

{{/post}}
