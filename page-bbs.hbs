{{!< default}}
{{!-- Template for the /bbs page. Ghost Admin: create a page with slug "bbs".
     Fetches art + stories from BBS API. No iframe, no duplicate wordmark.
     Layout: Recent Stories → Art Gallery → CTA --}}

{{#post}}
<main class="gh-main">
    <article class="gh-article {{post_class}}">

        <section class="gh-content gh-canvas bbs-page-section">

            {{!-- Skeleton shown while API call is in flight --}}
            <div class="bbs-loading" id="bbs-loading">
                <div class="bbs-loading-bar"></div>
            </div>

            {{!-- ── RECENT STORIES ─────────────────────────────────────────── --}}
            <div class="bbs-section" id="bbs-stories-section" style="display:none">
                <h3 class="bbs-section-heading">Recent Stories</h3>
                <ul class="bbs-stories" id="bbs-stories"></ul>
            </div>

            <hr class="bbs-rule" id="bbs-rule-1" style="display:none">

            {{!-- ── ART GALLERY ──────────────────────────────────────────────── --}}
            <div class="bbs-section" id="bbs-art-section" style="display:none">
                <h3 class="bbs-section-heading">Art Gallery</h3>
                <pre class="bbs-art" id="bbs-art" aria-label="ASCII gallery art"></pre>
                <p class="bbs-caption" id="bbs-caption"></p>
            </div>

            <hr class="bbs-rule" id="bbs-rule-2" style="display:none">

            {{!-- ── CTA ─────────────────────────────────────────────────────── --}}
            {{#unless @member}}
            {{!-- Non-subscriber: plain text link only — nav + footer already have subscribe buttons --}}
            <p class="bbs-access-hint" id="bbs-cta-public" style="display:none">
                <a href="#/portal/signup" data-portal="signup">Subscribe for access →</a>
            </p>
            {{else}}
            {{!-- Member: single button, hidden until member-status resolves --}}
            <div class="bbs-cta-wrap" id="bbs-member-cta" style="display:none">
                <a
                    href="https://bbs.southpole.blog"
                    id="bbs-enter-btn"
                    class="gh-button"
                    style="display:none"
                >BBS Login →</a>
                <button
                    id="bbs-invite-btn"
                    class="gh-button gh-button-secondary"
                    type="button"
                    style="display:none"
                >Send my BBS invite →</button>
                <p id="bbs-invite-confirm" class="bbs-invite-confirm" style="display:none"></p>
            </div>
            {{/unless}}

        </section>

    </article>
</main>

<style>
    .bbs-page-section {
        padding-top: 0;
    }

    /* Loading skeleton */
    .bbs-loading {
        padding: 40px 0;
        display: flex;
        justify-content: center;
    }

    .bbs-loading-bar {
        width: 120px;
        height: 3px;
        background: #ccc;
        border-radius: 2px;
        animation: bbs-pulse 1.4s ease-in-out infinite;
    }

    @keyframes bbs-pulse {
        0%, 100% { opacity: 0.3; }
        50%       { opacity: 1; }
    }

    /* Section headings — match Ghost's h3 but stay in flow */
    .bbs-section {
        margin-bottom: 4px;
    }

    .bbs-section-heading {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--color-darkgrey, #15171a);
        margin: 0 0 12px;
        padding: 0;
    }

    /* Stories */
    .bbs-stories {
        list-style: none;
        padding: 0;
        margin: 0;
        font-family: 'Courier New', Courier, monospace;
        font-size: 14px;
        font-weight: 600;
        color: var(--color-darkgrey, #15171a);
        line-height: 1.8;
    }

    .bbs-stories li::before {
        content: '> ';
        opacity: 0.4;
    }

    /* Art — Ghost themes often set line-height and background on pre;
       override with high specificity and inline style fallback in JS */
    .gh-content .bbs-art,
    .bbs-art {
        font-family: 'Courier New', Courier, 'Lucida Console', monospace;
        font-size: clamp(5px, 0.7vw, 7px);
        line-height: 1 !important;
        white-space: pre;
        overflow: hidden;
        margin: 0 0 10px;
        padding: 0 !important;
        background: transparent !important;
        border: none !important;
        border-radius: 0 !important;
        box-shadow: none !important;
    }

    /* Every span the ANSI renderer injects must be consistent height.
       Without this, spans with background-color stretch taller than
       bare text nodes, creating alternating short/tall rows. */
    .bbs-art span {
        display: inline;
        line-height: 1;
        vertical-align: bottom;
    }

    .bbs-caption {
        font-family: 'Courier New', Courier, monospace;
        font-size: 13px;
        font-weight: 600;
        color: var(--color-darkgrey, #15171a);
        margin: 0;
    }

    /* Divider */
    .bbs-rule {
        border: none;
        border-top: 1px solid var(--color-border, #e5e7eb);
        margin: 20px 0;
    }

    /* Non-subscriber text hint */
    .bbs-access-hint {
        text-align: center;
        font-size: 0.9rem;
        margin: 4px 0 8px;
    }

    /* Member CTA button */
    .bbs-cta-wrap {
        text-align: center;
        padding: 4px 0 8px;
    }

    /* .gh-content a overrides gh-button's white text color — fix it */
    .bbs-cta-wrap a.gh-button {
        color: #fff;
        text-decoration: none;
    }

    .bbs-invite-confirm {
        margin-top: 10px;
        font-size: 0.875rem;
        color: var(--color-secondary-text, #6b7280);
    }
</style>

{{!-- ── JS: fetch BBS preview, render content, show CTA ──────────────── --}}
<script>
(function () {
    var ANSI_TABLE = [[0,0,0],[128,0,0],[0,128,0],[128,128,0],[0,0,128],[128,0,128],[0,128,128],[192,192,192],[128,128,128],[255,0,0],[0,255,0],[255,255,0],[0,0,255],[255,0,255],[0,255,255],[255,255,255]];
    function ansi256(c){if(c<16)return ANSI_TABLE[c];if(c>=232){var g=8+(c-232)*10;return[g,g,g];}var i=c-16,r=Math.floor(i/36),g=Math.floor((i%36)/6),b=i%6,s=function(v){return Math.round((v/5)*255);};return[s(r),s(g),s(b)];}
    function esc(s){return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
    function ansiToHtml(input){var re=/\x1b\[[0-9;]*m/g,fg=null,bg=null,html='',last=0,m;
        function span(t){if(!t)return;var st=[];if(fg!==null){var c=ansi256(fg);st.push('color:rgb('+c[0]+','+c[1]+','+c[2]+')');}if(bg!==null){var c2=ansi256(bg);st.push('background:rgb('+c2[0]+','+c2[1]+','+c2[2]+')');}html+='<span'+(st.length?' style="'+st.join(';')+'"':'')+'>'+esc(t)+'</span>';}
        while((m=re.exec(input))!==null){span(input.slice(last,m.index));var codes=m[0].slice(2,-1).split(';').filter(Boolean).map(Number);if(!codes.length){fg=null;bg=null;}else{for(var i=0;i<codes.length;i++){var c=codes[i];if(c===0){fg=null;bg=null;}else if(c===38&&codes[i+1]===5){fg=codes[i+2];i+=2;}else if(c===48&&codes[i+1]===5){bg=codes[i+2];i+=2;}}}last=re.lastIndex;}span(input.slice(last));return html;}

    function show(el){ if(el) el.style.display = ''; }

    var loadingEl      = document.getElementById('bbs-loading');
    var storiesSect    = document.getElementById('bbs-stories-section');
    var storiesEl      = document.getElementById('bbs-stories');
    var rule1          = document.getElementById('bbs-rule-1');
    var artSect        = document.getElementById('bbs-art-section');
    var artEl          = document.getElementById('bbs-art');
    var captionEl      = document.getElementById('bbs-caption');
    var rule2          = document.getElementById('bbs-rule-2');
    var ctaPublic      = document.getElementById('bbs-cta-public');

    fetch('https://bbs.southpole.blog/api/bbs-preview')
        .then(function(r){ return r.json(); })
        .then(function(data){
            if (loadingEl) loadingEl.style.display = 'none';

            // Stories
            if (storiesEl) {
                var items = (data.stories && data.stories.length)
                    ? data.stories.map(function(t){ return '<li>' + esc(t) + '</li>'; }).join('')
                    : '<li style="opacity:0.4">No stories yet.</li>';
                storiesEl.innerHTML = items;
                show(storiesSect);
                show(rule1);
            }

            // Art
            if (data.art && artEl) {
                artEl.innerHTML = ansiToHtml(data.art);
                // Force line-height via inline style to override any Ghost theme rule
                artEl.style.lineHeight = '1';
                show(artSect);
                show(rule2);
            }

            // Caption
            if (captionEl) {
                var parts = [data.title, data.artist].filter(Boolean);
                if (parts.length) captionEl.textContent = parts.join(' \u2014 ');
            }

            // Non-member CTA — reveal after content is ready
            if (ctaPublic) show(ctaPublic);
        })
        .catch(function(){
            if (loadingEl) loadingEl.style.display = 'none';
        });
}());
</script>

{{!-- Member CTA — separate block so Handlebars can emit the member uuid --}}
{{#unless @member}}{{else}}
<script>
(function () {
    var enterBtn  = document.getElementById('bbs-enter-btn');
    var inviteBtn = document.getElementById('bbs-invite-btn');
    var confirm   = document.getElementById('bbs-invite-confirm');
    var ctaWrap   = document.getElementById('bbs-member-cta');
    var uuid      = '{{@member.uuid}}';

    function showCta(el) {
        if (el) el.style.display = '';
        if (ctaWrap) ctaWrap.style.display = '';
    }

    if (!uuid) { showCta(enterBtn); return; }

    fetch('https://bbs.southpole.blog/api/member-status?uuid=' + encodeURIComponent(uuid), { credentials: 'omit' })
        .then(function(r){ return r.json(); })
        .then(function(data){
            if (data && data.hasHandle === false) {
                showCta(inviteBtn);
            } else {
                showCta(enterBtn);
            }
        })
        .catch(function(){
            showCta(enterBtn);
        });

    if (inviteBtn) {
        inviteBtn.addEventListener('click', function(){
            inviteBtn.disabled = true;
            fetch('https://bbs.southpole.blog/api/resend-welcome', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ uuid: uuid }),
                credentials: 'omit'
            })
            .then(function(){
                if (confirm) { confirm.textContent = 'Done — check your inbox for the invite link.'; confirm.style.display = ''; }
                inviteBtn.style.display = 'none';
            })
            .catch(function(){
                inviteBtn.disabled = false;
                if (confirm) { confirm.textContent = 'Something went wrong. Please try again.'; confirm.style.display = ''; }
            });
        });
    }
}());
</script>
{{/unless}}

{{/post}}
